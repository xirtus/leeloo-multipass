{
  "name": "leeloo-multipass",
  "version": "0.1.0",
  "description": "Reusable Fastify and PostgreSQL account-linking Passport core",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "migrate": "node dist/lib/migrate.js",
    "check": "node --check src/ui/networks.js"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "@fastify/cookie": "^11.0.0"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "0.5.16",
    "ipaddr.js": "^2.5.0",
    "undici": "^7.30.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "fastify": "^5.12.1",
    "@fastify/cookie": "^11.1.2",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirtus/leeloo-multipass.git"
  },
  "bugs": {
    "url": "https://github.com/xirtus/leeloo-multipass/issues"
  },
  "author": "Andreas Xirtus"
}
